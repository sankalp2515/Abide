# IntentSeal Delegate configuration. Copy to .env; every value is optional for a local run.
# Never commit .env. For any shared or public host, replace every "local" default with a long random value.

# ---- Google Cloud (recommended): Gemini on Vertex AI and Model Armor, with Google credentials, no API key ----
# On Cloud Run the service's own identity is used. Locally: `gcloud auth application-default login`, and for Docker
# also docker-compose.google.yml (mounts those credentials read-only).
# GOOGLE_CLOUD_PROJECT=your-project-id          # turns on Gemini on Vertex AI (cards, receipts and the live agents)
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_CLOUD_QUOTA_PROJECT=your-project-id    # bill this project even if your laptop's default is another one
# INTENTSEAL_MODEL_ARMOR_TEMPLATE=projects/your-project-id/locations/us-central1/templates/your-template
# INTENTSEAL_DELEGATE_AGENT_MODEL=gemini-3.5-flash

# ---- Gemini API key (alternative to Vertex AI; free tier is enough to try the cards and receipts) ----
# GEMINI_API_KEY=your-gemini-api-key

# ---- Access (name:key:scope, comma separated; scopes: project = an employee or agent runtime, admin = reviewer) ----
# INTENTSEAL_API_KEYS=employee:<random>:project,reviewer:<random>:admin
# INTENTSEAL_PUBLIC_KEY=<random>            # read-only key built into the Console; reads no delegations

# ---- Secrets ----
# INTENTSEAL_DELEGATE_SECRET=<random 32+ bytes>   # signs agent-to-agent handoffs; keep stable across restarts
# POSTGRES_PASSWORD=<random>

# ---- Behaviour (defaults shown) ----
# INTENTSEAL_APPROVAL_TTL_S=900             # a question to the employee expires after 15 minutes
# INTENTSEAL_DRAFTER_TIMEOUT_S=12           # how long the card waits for Gemini before the word rules answer
# INTENTSEAL_DRAFTER_COOLDOWN_S=120         # skip Gemini for this long after it fails
# INTENTSEAL_DELEGATE_RETENTION_DAYS=       # delete raw third-party text older than this (receipts are kept)
# INTENTSEAL_DELEGATE_DEMO=1                # 0 turns the sandbox demo off
# INTENTSEAL_LOG_LEVEL=info
